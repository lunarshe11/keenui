#!/opt/bin/sh
export PATH=/opt/bin:/opt/sbin:/bin:/sbin:/usr/bin:/usr/sbin

F=""
if [ -n "$QUERY_STRING" ]; then
  for pair in $(echo "$QUERY_STRING" | tr '&' ' '); do
    k="${pair%%=*}"; v="${pair#*=}"
    case "$k" in
      path) F=$(echo "$v" | sed 's/%20/ /g; s/%2F/\//g; s/%3A/:/g; s/%28/(/g; s/%29/)/g; s/%5B/[/g; s/%5D/]/g') ;;
    esac
  done
fi

if [ ! -f "$F" ]; then
  echo "Status: 404 Not Found"
  echo "Content-Type: text/plain; charset=utf-8"
  echo ""
  echo "File not found: $F"
  exit 0
fi

case "$F" in
  *.png) MT="image/png" ;;
  *.jpg|*.jpeg) MT="image/jpeg" ;;
  *.gif) MT="image/gif" ;;
  *.svg) MT="image/svg+xml" ;;
  *.pdf) MT="application/pdf" ;;
  *.txt|*.log|*.conf|*.md|*.sh|*.cgi|*.py) MT="text/plain; charset=utf-8" ;;
  *.json) MT="application/json" ;;
  *.zip) MT="application/zip" ;;
  *.mp4) MT="video/mp4" ;;
  *.mp3) MT="audio/mpeg" ;;
  *.html|*.htm) MT="text/html; charset=utf-8" ;;
  *.css) MT="text/css" ;;
  *.js) MT="application/javascript" ;;
  *) MT="application/octet-stream" ;;
esac

SIZE=$(wc -c < "$F" 2>/dev/null | tr -cd '0-9')
[ -z "$SIZE" ] && SIZE=0
BN=$(basename "$F")

echo "Content-Type: $MT"
echo "Content-Length: $SIZE"
echo "Content-Disposition: inline; filename=\"$BN\""
echo ""
cat "$F"
