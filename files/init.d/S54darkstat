#!/opt/bin/sh

PROG=/opt/sbin/darkstat
ARGS="-i br0 -p 667 -b 127.0.0.1 --chroot /opt/var/empty --no-dns --import /opt/var/lib/darkstat/darkstat.db --export /opt/var/lib/darkstat/darkstat.db --syslog"
PIDFILE=/opt/var/run/darkstat.pid

start() {
    echo -n " Starting darkstat... "
    if [ -f "$PIDFILE" ] && kill -0 $(cat "$PIDFILE") 2>/dev/null; then
        echo "already running"
        return
    fi
    $PROG $ARGS
    sleep 2
    PID=$(ps | grep darkstat | grep -v grep | awk '{print $1}' | head -1)
    if [ -n "$PID" ]; then
        echo "$PID" > "$PIDFILE"
        echo "done (pid $PID)"
    else
        echo "failed"
    fi
}

stop() {
    echo -n " Stopping darkstat... "
    killall darkstat 2>/dev/null
    sleep 1
    rm -f "$PIDFILE"
    echo "done"
}

restart() {
    stop
    sleep 1
    start
}

status() {
    if ps | grep darkstat | grep -v grep > /dev/null; then
        echo "darkstat is running"
    else
        echo "darkstat is stopped"
    fi
}

case "$1" in
    start)   start ;;
    stop)    stop ;;
    restart) restart ;;
    status)  status ;;
    *)       echo "Usage: $0 {start|stop|restart|status}" ;;
esac
